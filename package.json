{
  "name": "portfolio",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "npx rimraf .next .turbo",    
    "build": "next build && pagefind --site out --output-path public/_pagefind",
    "dev": "next --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.8",
    "nextra": "^4.6.1",
    "nextra-theme-blog": "^4.6.1",
    "react": "^19.3.0",
    "react-cusdis": "^2.1.3",
    "react-dom": "^19.3.0"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "semi": false
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
